{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "skyleax-task-08",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-11",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "accesshub-db",
      "database_id": "a50710b9-8b82-4f76-a71d-8d250e4c4af2",
      "migrations_dir": "migrations"
    }
  ]
}
