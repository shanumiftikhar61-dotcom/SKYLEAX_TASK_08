{
  "name": "accesshub",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server/server.js",
    "client": "vite",
    "build": "vite build",
    "start": "node server/server.js",
    "test": "node --test",
    "cf:dev": "wrangler dev",
    "cf:deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply accesshub-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply accesshub-db --remote"
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "express": "^4.22.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.2.5",
    "supertest": "^7.3.1",
    "vite": "^7.3.7",
    "wrangler": "^4.160.0"
  }
}
