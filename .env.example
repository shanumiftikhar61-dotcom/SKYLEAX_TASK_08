# Copy to .env for local development and set real values in production.
NODE_ENV=development
PORT=3002
ACCESSHUB_DB_PATH=./server/data/accesshub.db
ACCESSHUB_ADMIN_PASSWORD=change-me-admin-password-12+
ACCESSHUB_MANAGER_PASSWORD=change-me-manager-password-12+
ACCESSHUB_USER_PASSWORD=change-me-user-password-12+
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax
