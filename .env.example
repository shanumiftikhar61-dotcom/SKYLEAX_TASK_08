# Copy to .env and set unique seed passwords before the first server launch.
# Leave optional seed accounts unset if this environment needs only public Member registration.
NODE_ENV=development
PORT=3002
ACCESSHUB_DB_PATH=./server/data/accesshub.db
ACCESSHUB_ADMIN_PASSWORD=
ACCESSHUB_MANAGER_PASSWORD=
ACCESSHUB_USER_PASSWORD=
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax
